{
  "name": "ethiopian-hotel-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Ethiopian Hotel Management System (HMS) - Next.js + NestJS + Tauri 2 Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@ehms/web",
    "dev:api": "turbo run dev --filter=@ehms/api",
    "dev:tauri": "pnpm --filter=@ehms/tauri tauri dev",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@ehms/web",
    "build:api": "turbo run build --filter=@ehms/api",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "db:migrate": "pnpm --filter=@ehms/api prisma migrate dev",
    "db:seed": "pnpm --filter=@ehms/api prisma db seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.5",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
