# ─── Environment & Ports ─────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# ─── Web Client & CORS ───────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=am
NEXT_PUBLIC_DEFAULT_CURRENCY=ETB

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
POSTGRES_USER=hms_admin
POSTGRES_PASSWORD=hms_secure_pass
POSTGRES_DB=hms_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hms_admin:hms_secure_pass@localhost:5432/hms_db

# ─── Redis Cache & Realtime ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ─── MinIO / S3 Object Storage ───────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_BUCKET=hms-attachments

# ─── Authentication & Security ───────────────────────────────────────────────
JWT_ACCESS_SECRET=hms_super_secret_access_jwt_key_2026_dev_secure
JWT_REFRESH_SECRET=hms_super_secret_refresh_jwt_key_2026_dev_secure
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Ethiopian Integrations (Optional / Future) ──────────────────────────────
# Telebirr
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_API_URL=https://app.ethiomobilemoney.et:2121

# Chapa
CHAPA_SECRET_KEY=CHASECK_TEST-xxxx
CHAPA_WEBHOOK_SECRET=chapa-secret

# EIRS / MOR Fiscal Integration (Ethiopian Invoicing)
EIRS_API_ENDPOINT=https://fiscal.gov.et/api/v1
EIRS_TIN_NUMBER=0012345678
EIRS_MACHINE_ID=POS-ADDIS-01

# SMS Gateway
SMS_GATEWAY_URL=
SMS_API_KEY=
