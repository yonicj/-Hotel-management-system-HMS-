# Environment Configuration
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Next.js App
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=am
NEXT_PUBLIC_DEFAULT_CURRENCY=ETB

# NestJS API
API_PORT=4000
API_PREFIX=api/v1
JWT_SECRET=super-secret-jwt-key-for-ethiopian-hms
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=super-secret-refresh-key
REFRESH_TOKEN_EXPIRES_IN=7d

# PostgreSQL Database
DATABASE_URL=postgresql://hms_admin:hms_secure_pass@localhost:5432/ethiopian_hms?schema=public

# Redis Cache & PubSub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO / S3 Object Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=hms-attachments

# Ethiopian Integrations
# Telebirr
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_API_URL=https://app.ethiomobilemoney.et:2121

# Chapa
CHAPA_SECRET_KEY=CHASECK_TEST-xxxx
CHAPA_WEBHOOK_SECRET=chapa-secret

# EIRS / MOR Fiscal Integration (Ethiopian Invoicing)
EIRS_API_ENDPOINT=https://fiscal.gov.et/api/v1
EIRS_TIN_NUMBER=0012345678
EIRS_MACHINE_ID=POS-ADDIS-01

# SMS Gateway
SMS_GATEWAY_URL=
SMS_API_KEY=
